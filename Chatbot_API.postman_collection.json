              "mode": "raw",
              "raw": "{\n  \"message\": \"Chào bạn, bạn là ai?\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/client/chatbot/chat",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["client", "chatbot", "chat"]
